[Unit]
Description=ASTP Network Probe scheduled client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/astp-probe run --config /etc/astp-probe/client.toml
EnvironmentFile=-/etc/astp-probe/client.env
Restart=on-failure
RestartSec=3
# `astp-probe run` exits with 69 (EX_UNAVAILABLE) while scheduling is not
# implemented: that is not a failure a restart can fix.
RestartPreventExitStatus=69

# Unprivileged transient user; /var/lib/astp-probe is created and owned by it.
DynamicUser=yes
StateDirectory=astp-probe
# SO_BINDTODEVICE for client.bind_interface. Linux 5.7+ allows it without
# privileges on an unbound socket; older kernels need CAP_NET_RAW. Remove
# both lines if bind_interface is not used.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=ASTP Network Probe diagnostic server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/astp-probe-server --config /etc/astp-probe/server.toml
EnvironmentFile=-/etc/astp-probe/server.env
Restart=on-failure
RestartSec=3

# Unprivileged transient user; /var/lib/astp-probe is created and owned by it.
DynamicUser=yes
StateDirectory=astp-probe
# Port 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# The certificate and key stay root-only in /etc/astp-probe; systemd copies
# them to /run/credentials/astp-probe-server.service/, readable by the
# service user only. server.toml must point there (see README.md).
LoadCredential=cert.pem:/etc/astp-probe/cert.pem
LoadCredential=key.pem:/etc/astp-probe/key.pem

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

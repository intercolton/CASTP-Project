[Unit]
Description=ASTP-M VPN client
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/astp-client --config /etc/astp/client.toml
# ASTP_SECRET=..., readable by root only.
EnvironmentFile=-/etc/astp/client.env
Restart=on-failure
RestartSec=5

DynamicUser=yes
# TUN device, addresses and routes (ip and resolvectl run with these).
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
DeviceAllow=/dev/net/tun rw

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
